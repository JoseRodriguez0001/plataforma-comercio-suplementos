# =====================================================================
# Plantilla de variables de entorno. Copiar a .env y completar.
# NUNCA versionar el .env real (está en .gitignore).
# Cada app (apps/backend, apps/storefront) tiene su propio .env;
# este archivo documenta TODAS las variables del proyecto.
# =====================================================================

# ---------- Backend Medusa (apps/backend) ----------
# Conexión a la BD local (docker-compose)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_store
REDIS_URL=redis://localhost:6379

# Secretos (generar valores aleatorios largos; NO usar estos en prod)
JWT_SECRET=cambia-esto-por-un-secreto-largo
COOKIE_SECRET=cambia-esto-por-un-secreto-largo

# CORS (orígenes permitidos)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Worker: "shared" (dev) | "server" | "worker" (prod separa server/worker)
MEDUSA_WORKER_MODE=shared

# ---------- Almacenamiento de imágenes: Cloudflare R2 (S3-compatible) ----------
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# ---------- Email transaccional: Resend ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------- Búsqueda: Meilisearch ----------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# ---------- Pagos (cuentas del dueño — se completan al tener credenciales) ----------
# Yappy (Banco General)
YAPPY_MERCHANT_ID=
YAPPY_SECRET=
# PagueloFacil
PAGUELOFACIL_CCLW=
PAGUELOFACIL_API_KEY=
# Modo de pasarelas: sandbox | production
PAYMENT_MODE=sandbox

# ---------- Auth social: Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Observabilidad: Sentry ----------
SENTRY_DSN=

# ---------- Storefront Next.js (apps/storefront) ----------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Publishable API key del sales channel (se genera en el admin de Medusa)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
